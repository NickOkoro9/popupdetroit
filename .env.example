# Copy to .env only if you do not already have a local .env.
# All credentials below are intentionally blank. Never commit real values.
# Only Supabase's URL and publishable key belong in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_IMPORT_PASSCODE=

# IBM watsonx.ai: configure your project's region and available chat model.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct

# Optional alternative providers. Leave unused keys blank.
LOVABLE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional database migration connection, managed through Lovable.
LOVABLE_DB_MIGRATION_URL=
